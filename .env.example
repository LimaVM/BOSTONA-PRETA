# Network configuration
HOST=0.0.0.0
PORT=443
HTTP_REDIRECT_PORT=80

# TLS certificate paths (Certbot defaults)
SSL_KEY_PATH=/etc/letsencrypt/live/vegaconsultoria.com/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/vegaconsultoria.com/fullchain.pem
# Optional intermediate/CA bundle
SSL_CA_PATH=

# Security controls
# Comma-separated hosts that are allowed in the Host header
ALLOWED_HOSTS=vegaconsultoria.com,www.vegaconsultoria.com
# Rate limiting window (ms) and max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
